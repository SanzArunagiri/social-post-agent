# social-post-agent configuration
# Copy to .env and fill in. Only API_KEY, ENCRYPTION_KEY and PUBLIC_URL are required to start;
# each platform works once its developer-app credentials are set and an account is connected.

# ---------------------------------------------------------------- required

# Secret for the REST API and the MCP server. Clients send it as "Authorization: Bearer <API_KEY>"
# (or "X-API-Key: <API_KEY>"). 16+ characters - generate with:  openssl rand -hex 32
API_KEY=

# Encrypts platform tokens stored in the database. 16+ characters - generate with:  openssl rand -hex 32
# Keep it safe: if it changes, stored tokens can't be read and every account must be connected again.
ENCRYPTION_KEY=

# The public https address of this server, without a trailing slash (e.g. https://social.example.com).
# Used for OAuth redirect URIs (/callback/<provider>) and for media URLs that Instagram, Threads and
# Facebook download from (/media/<id>). Must be reachable from the internet over https.
PUBLIC_URL=

# ---------------------------------------------------------------- server

# Host port docker compose publishes (the container always listens on 8000).
PORT=8000

# Time zone for times given without an offset ("2026-12-01T09:30") and for times shown back.
TIMEZONE=UTC

# Where the SQLite database and media files live (the Docker volume is mounted here).
DATA_DIR=/data

# Optional: use Postgres instead of SQLite, e.g. postgresql://user:password@db:5432/social
DATABASE_URL=

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# true = serve interactive API docs at /docs (the schema only - no data, no auth needed for the page itself)
API_DOCS=false

# Optional: also serve MCP at <PUBLIC_URL>/mcp/<MCP_URL_KEY> without a header, for MCP clients that can't
# send an Authorization header. 24+ random characters; anyone with this URL can use the agent.
MCP_URL_KEY=

# Which proxies may set X-Forwarded-For (used for the per-IP rate limits). "*" is right when the port
# is reachable only by your reverse proxy (the default compose file binds 127.0.0.1). If you expose
# the port directly to the internet, set 127.0.0.1 so clients can't spoof their address.
FORWARDED_ALLOW_IPS=*

# ---------------------------------------------------------------- Meta: Facebook Pages + Instagram
# One Meta app with "Facebook Login for Business". Redirect URI: <PUBLIC_URL>/callback/facebook
# Connecting Facebook also connects the Instagram professional accounts linked to your Pages.
META_APP_ID=
META_APP_SECRET=
# Graph API version used for all Meta calls.
META_GRAPH_VERSION=v23.0

# ---------------------------------------------------------------- Threads
# The Threads use case of a Meta app has its own app id / secret (shown under "Threads API" settings).
# Redirect URI: <PUBLIC_URL>/callback/threads
THREADS_APP_ID=
THREADS_APP_SECRET=

# ---------------------------------------------------------------- X (Twitter)
# OAuth 2.0 client from the X developer portal (User authentication settings, type "Web App").
# Redirect URI: <PUBLIC_URL>/callback/x
# Posting needs an X API plan / credits with write access - see README.
X_CLIENT_ID=
# Only for confidential clients ("Web App"); leave empty for a public client.
X_CLIENT_SECRET=
# Max post length checked before posting (X Premium accounts can post longer).
X_MAX_CHARS=280

# ---------------------------------------------------------------- Google: YouTube
# OAuth client (type "Web application") in Google Cloud with the YouTube Data API v3 enabled.
# Authorized redirect URI: <PUBLIC_URL>/callback/youtube
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Privacy for uploads when the call doesn't say: public | unlisted | private
YOUTUBE_DEFAULT_PRIVACY=public

# ---------------------------------------------------------------- Telegram (optional)
# Bot token from @BotFather and the chat id to notify (send the bot a message, then open
# https://api.telegram.org/bot<TOKEN>/getUpdates to find chat.id).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Which publish results to send: all | failures | off
TELEGRAM_NOTIFY=all

# ---------------------------------------------------------------- media and jobs

# Largest file accepted (MB). Platform limits are checked separately when posting.
MEDIA_MAX_MB=512
# Delete a media file this many minutes after every post using it is out on every platform (-1 = never).
MEDIA_DELETE_AFTER_MINUTES=30
# Keep files that no post uses (or only cancelled posts use) this many days.
MEDIA_KEEP_UNUSED_DAYS=7
# One-time upload links: lifetime, files per link, uploads per minute per IP / per link.
UPLOAD_LINK_MINUTES=60
UPLOAD_LINK_MAX_FILES=20
UPLOAD_RATE_PER_MINUTE=30
# How often followers and post metrics are refreshed (hours, 0 = only on request).
INSIGHTS_REFRESH_HOURS=6
# How often the scheduler looks for posts that are due (seconds).
SCHEDULER_INTERVAL_SECONDS=30
# Hand future Facebook posts and YouTube videos to the platform's own scheduler (true) or always post
# them from this server at the time (false).
NATIVE_SCHEDULING=true
